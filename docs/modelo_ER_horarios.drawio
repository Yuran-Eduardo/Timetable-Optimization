mxCell id="c157" value="pertence a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c121" target="c130"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c158" value="inclui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c139" target="c130"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c159" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;PK = chave primária (identifica a linha)&lt;br&gt;FK = chave estrangeira (aponta para outra tabela)&lt;br&gt;Azul = vem do CSV das salas · Verde = vem do CSV dos horários&lt;br&gt;Vermelho = tabela central (aula) · Amarelo = tabela de ligação N:M&lt;br&gt;Traço com &quot;pé de galinha&quot; = lado MUITOS · traço simples = lado UM · círculo = opcional (0 ou 1)" style="text;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="560" width="680" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>